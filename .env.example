# Copy this file to ".env" and fill in your own values.
PORT=3000
# Any long random text. Keeps customer and admin logins secure.
JWT_SECRET=change-this-to-a-long-random-text
# Admin login created on the very first run. If you leave the password empty,
# a random one is printed in the terminal on first run.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# Set to production when the site is live on HTTPS
NODE_ENV=development
